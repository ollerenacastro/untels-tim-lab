# ── OpenCTI ──────────────────────────────────────
OPENCTI_BASE_URL=http://localhost:8080
OPENCTI_ADMIN_EMAIL=admin@tim.local
OPENCTI_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
OPENCTI_ADMIN_TOKEN=REPLACE_WITH_UUID

# ── RabbitMQ ─────────────────────────────────────
RABBITMQ_USER=tim
RABBITMQ_PASSWORD=REPLACE_WITH_PASSWORD

# ── MinIO ────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=REPLACE_WITH_PASSWORD

# ── Conectores OpenCTI (IDs autogenerados por setup-env.sh) ──
CONNECTOR_OPENCTI_ID=REPLACE_WITH_UUID
CONNECTOR_MITRE_ID=REPLACE_WITH_UUID
CONNECTOR_CISA_KEV_ID=REPLACE_WITH_UUID
CONNECTOR_ALIENVAULT_ID=REPLACE_WITH_UUID
CONNECTOR_MISP_FEED_ID=REPLACE_WITH_UUID

# ── Feeds externos (OPCIONALES) ──────────────────
# URLhaus y Feodo funcionan sin registro: el lab arranca completo sin tocar nada
# de aquí abajo. Con estas claves se habilitan fuentes adicionales.
#
#   OTX_API_KEY            → https://otx.alienvault.com (Settings → OTX Key)
#                            Habilita el feed OTX del feed-orchestrator Y el
#                            servicio connector-alienvault del docker-compose.
#   MALWAREBAZAAR_AUTH_KEY → https://auth.abuse.ch  (una sola clave sirve
#   THREATFOX_AUTH_KEY     → https://auth.abuse.ch   para ambos servicios)
#
# Sin valor, cada feed queda en estado "disabled" y el resto sigue funcionando.
OTX_API_KEY=
MALWAREBAZAAR_AUTH_KEY=
THREATFOX_AUTH_KEY=

# ── Servicios opcionales ─────────────────────────
# El conector oficial de AlienVault (connector-alienvault) NO arranca por
# defecto: sin OTX_API_KEY entraría en bucle de reinicios. Para habilitarlo,
# pon la clave arriba y descomenta la línea siguiente. A partir de ahí,
# `docker compose up -d` y `./scripts/restart-lab.sh` ya lo incluyen solos.
#COMPOSE_PROFILES=otx

# El conector de MISP Feed (connector-misp-feed) tampoco arranca por defecto:
# necesita la URL de un feed MISP y suma 384 MB al presupuesto de memoria.
# Para activarlo, pon la URL abajo y añade "misp" al perfil, separado por coma:
#   COMPOSE_PROFILES=otx,misp
# Aporta eventos agrupados en reports, con tags y con la marca to_ids que
# distingue lo accionable de lo que no lo es — a diferencia de los indicadores
# sueltos que llegan por los feeds del orquestador.
MISP_FEED_URL=

# Desde qué fecha importar eventos del feed MISP. Misma advertencia que con la
# ventana de OTX: cuanto más atrás, más entra en la cola.
# Si no se define, el compose usa 2026-07-01.
#MISP_FEED_FROM=2026-07-01

# Desde qué fecha importar pulses de OTX. Cada pulse pasa por la cola y un solo
# worker procesa ~9 bundles/s en esta VM, así que la ventana define cuánto tarda:
#   7 días ≈ 15 000 bundles ≈ 30 min   (valor por defecto si no se define)
#   1 mes  ≈ 70 000 bundles ≈  2 h     (medido en una VM de 8 GB)
# Descoméntala solo para ampliar la ventana, y hazlo fuera de horario de clase.
#ALIENVAULT_PULSE_START=2026-07-01T00:00:00
